---
import { SITE } from '#astrowind:config';

const BASE_PATHNAME = SITE.base || '/';
---

<link rel="shortcut icon" href={BASE_PATHNAME + 'favicon.ico'} />
<link rel="icon" type="image/svg+xml" href={BASE_PATHNAME + 'favicon.svg'} />
<link rel="apple-touch-icon" sizes="180x180" href={BASE_PATHNAME + 'apple-touch-icon.png'} />
