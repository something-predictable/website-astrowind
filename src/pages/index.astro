---
import Layout from '@riddance/astrowind/layouts/PageLayout.astro'
import Header from '@riddance/astrowind/components/widgets/Header.astro'
import Hero from '@riddance/astrowind/components/widgets/Hero.astro'
import CallToAction from '@riddance/astrowind/components/widgets/CallToAction.astro'
import { SITE, METADATA } from '#astrowind:config'

const metadata = {
  title: SITE.name,
}
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header isSticky showToggleTheme />
  </Fragment>

  <Hero
    id="hero"
    title={SITE.name}
    actions={[{ variant: 'primary', text: 'Contact', href: '#contact' }]}
  >
    <Fragment slot="subtitle">{METADATA.description}</Fragment>
  </Hero>

  <CallToAction
    id="contact"
    title="Let's create together"
    subtitle="Ready to ?"
    actions={[
      {
        variant: 'primary',
        text: 'Contact',
        href: 'contact',
      },
    ]}
  />
</Layout>
