---
import SinglePost from '@riddance/astrowind/components/blog/SinglePost.astro'
import ToBlogLink from '@riddance/astrowind/components/blog/ToBlogLink.astro'
import Layout from '@riddance/astrowind/layouts/PageLayout.astro'
import type { ImageMetadata } from 'astro'
import merge from 'lodash.merge'

import RelatedPosts from '@riddance/astrowind/components/blog/RelatedPosts.astro'
import type { MetaData } from '@riddance/astrowind/types'
import { blogPostRobots, getStaticPathsBlogPost } from '@riddance/astrowind/utils/blog.ts'
import { findImage } from '@riddance/astrowind/utils/images.ts'
import { getCanonical, getPermalink } from '@riddance/astrowind/utils/permalinks.ts'

export const prerender = true

export const getStaticPaths = async () => {
  return await getStaticPathsBlogPost()
}

const { post } = Astro.props
const i = post.image

const url = getCanonical(getPermalink(post.permalink, 'post'))
const image = await findImage(i)

const metadata = merge(
  {
    title: post.title,
    description: post.excerpt,
    robots: {
      index: blogPostRobots.index,
      follow: blogPostRobots.follow,
    },
    openGraph: {
      type: 'article',
      ...(image
        ? {
            images: [
              {
                url: image,
                width: (image as ImageMetadata | undefined)?.width,
                height: (image as ImageMetadata | undefined)?.height,
              },
            ],
          }
        : {}),
    },
  },
  {
    ...(post.metadata ? { ...post.metadata, canonical: post.metadata.canonical ?? url } : {}),
  },
) as MetaData
---

<Layout metadata={metadata}>
  <SinglePost post={{ ...post, image }} url={url}>
    {post.Content ? <post.Content /> : <Fragment set:html={post.content ?? ''} />}
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>
