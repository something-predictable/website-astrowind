---
import { blogCategoryRobots, getStaticPathsBlogCategory } from '@riddance/astrowind/utils/blog.ts'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'

import Headline from '@riddance/astrowind/components/blog/Headline.astro'
import BlogList from '@riddance/astrowind/components/blog/List.astro'
import Pagination from '@riddance/astrowind/components/blog/Pagination.astro'
import Layout from '@riddance/astrowind/layouts/PageLayout.astro'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page, category } = Astro.props
const { currentPage } = page

const metadata = {
  title: `Category '${category.title}' ${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  robots: {
    index: blogCategoryRobots.index,
    follow: blogCategoryRobots.follow,
  },
}
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline>{category.title}</Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
